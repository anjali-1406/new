from django.core.management.base import BaseCommand
from django.db import connection
from django.conf import settings
from django.contrib.auth import get_user_model

from apps.profiles.models import Profile


User = get_user_model()


class Command(BaseCommand):

    help = "Checks the health and configuration status of the project."

    def handle(self, *args, **options):

        self.stdout.write(
            self.style.SUCCESS(
                "\n========== PROJECT STATUS ==========\n"
            )
        )

        healthy = True

        # -------------------------------------------------
        # DATABASE CHECK
        # -------------------------------------------------

        try:

            connection.ensure_connection()

            self.stdout.write(
                self.style.SUCCESS(
                    "✓ Database connection        OK"
                )
            )

        except Exception:

            healthy = False

            self.stdout.write(
                self.style.ERROR(
                    "✗ Database connection        FAILED"
                )
            )

        # -------------------------------------------------
        # STRIPE SECRET KEY
        # -------------------------------------------------

        stripe_secret_key = getattr(
            settings,
            "STRIPE_SECRET_KEY",
            None
        )

        if stripe_secret_key:

            self.stdout.write(
                self.style.SUCCESS(
                    "✓ Stripe secret key          Configured"
                )
            )

        else:

            healthy = False

            self.stdout.write(
                self.style.ERROR(
                    "✗ Stripe secret key          Missing"
                )
            )

        # -------------------------------------------------
        # STRIPE WEBHOOK SECRET
        # -------------------------------------------------

        stripe_webhook_secret = getattr(
            settings,
            "STRIPE_WEBHOOK_SECRET",
            None
        )

        if stripe_webhook_secret:

            self.stdout.write(
                self.style.SUCCESS(
                    "✓ Stripe webhook secret      Configured"
                )
            )

        else:

            healthy = False

            self.stdout.write(
                self.style.ERROR(
                    "✗ Stripe webhook secret      Missing"
                )
            )

        # -------------------------------------------------
        # USERS COUNT
        # -------------------------------------------------

        try:

            user_count = User.objects.count()

            self.stdout.write(
                f"\nUsers                       : {user_count}"
            )

        except Exception:

            healthy = False

            self.stdout.write(
                self.style.ERROR(
                    "Users                       : Unable to read"
                )
            )

        # -------------------------------------------------
        # PROFILES COUNT
        # -------------------------------------------------

        try:

            profile_count = Profile.objects.count()

            self.stdout.write(
                f"Profiles                    : {profile_count}"
            )

        except Exception:

            healthy = False

            self.stdout.write(
                self.style.ERROR(
                    "Profiles                    : Unable to read"
                )
            )

        # -------------------------------------------------
        # VERIFIED PROFILES
        # -------------------------------------------------

        try:

            verified_count = Profile.objects.filter(
                is_verified=True
            ).count()

            self.stdout.write(
                f"Verified profiles           : {verified_count}"
            )

        except Exception:

            healthy = False

            self.stdout.write(
                self.style.ERROR(
                    "Verified profiles           : Unable to read"
                )
            )

        # -------------------------------------------------
        # FINAL STATUS
        # -------------------------------------------------

        self.stdout.write(
            "\n===================================="
        )

        if healthy:

            self.stdout.write(
                self.style.SUCCESS(
                    "Project status: HEALTHY"
                )
            )

        else:

            self.stdout.write(
                self.style.WARNING(
                    "Project status: CHECK REQUIRED"
                )
            )

        self.stdout.write(
            "====================================\n"
        )
