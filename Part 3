@pytest.mark.django_db
def test_like_post_requires_authentication(api_client, user):

    post = Post.objects.create(
        author=user,
        content="Protected Like",
    )

    url = reverse(
        "posts_api:post-like",
        args=[post.id],
    )

    response = api_client.post(url)

