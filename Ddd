services:
  web:
    build: .
    ports:
      - "8000:8000"

    env_file:
      - .env

    volumes:
      - .:/app
      - ./media:/app/media
      - ./staticfiles:/app/staticfiles

    environment:
      DB_HOST: host.docker.internal
      DB_PORT: 5432
      DB_NAME: facebook_DB
      DB_USER: postgres
      DB_PASSWORD: 12345

    extra_hosts:
      - "host.docker.internal:host-gateway"
